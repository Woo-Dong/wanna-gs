import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs';
import initSqlJs from 'sql.js';
import { DomainEngine,DomainFailure } from '../../src/domain/engine';
import { DemoRuntime,type SnapshotEnvelope,type SnapshotStore } from '../../src/db/runtime';
import type { DemoCommand,CreateRequest } from '../../src/contracts/domain';
const SQL=await initSqlJs();const bytes=new Uint8Array(fs.readFileSync('public/demo/seed.sqlite'));const manifest=JSON.parse(fs.readFileSync('public/demo/manifest.json','utf8'));
const NOW=Date.UTC(2026,8,21,3);let counter=0;
function setup(){const e=new DomainEngine(new SQL.Database(bytes),()=>NOW);const s=e.snapshot(e.scope());const store=s.stores[0].id,sku=s.conditions.find(c=>c.storeId===store)!.sku;const merchant='DEMO-MERCHANT-'+store;const customer='DEMO-CUSTOMER-001';function role(id:string){e.switchRole(id,e.scope())}function send(cmd:DemoCommand,id='CMD-'+(++counter)){return e.dispatch(cmd,{...e.scope(),commandId:id,correlationId:id})}function condition(patch:Record<string,unknown>){role(merchant);const c=e.condition(store,sku);send({type:'demo.updateCondition',storeId:store,sku,expectedConditionVersion:c.version,patch});role(customer)}function request(q=1,actor=customer){role(actor);const c=e.condition(store,sku);const input:CreateRequest={sku,storeId:store,quantity:q,acceptedPriceKrw:c.sale_price_krw,conditionVersion:c.version,consent:{accepted:true,termsVersion:'terms-v1'}};const r=send({type:'request.create',...input});return r.snapshot.requests.at(-1)!}function approve(){role(merchant);send({type:'merchant.review',storeId:store});const proposal=e.snapshot(e.scope()).proposals.filter(p=>p.status==='draft').at(-1)!;send({type:'proposal.approve',proposalId:proposal.id,expectedProposalVersion:proposal.version,confirmed:true});return e.snapshot(e.scope()).orders.at(-1)!}function supply(q:number,lineId?:string){role(merchant);const line=lineId??e.snapshot(e.scope()).orders.at(-1)!.lines[0].id;send({type:'demo.confirmSupply',lineId:line,confirmedQty:q});return line}return {e,store,sku,merchant,customer,role,send,condition,request,approve,supply}}
function code(fn:()=>unknown,want:string){assert.throws(fn,(e:unknown)=>e instanceof DomainFailure&&e.code===want)}
test('248 public SKU / 9 stores / SQLite FK and export-import preserve facts',()=>{const {e}=setup();assert.equal(e.rows('SELECT count(*) n FROM products')[0].n,248);assert.equal(e.rows('SELECT count(*) n FROM stores')[0].n,9);const clone=new DomainEngine(new SQL.Database(e.db.export()),()=>NOW);assert.equal(clone.rows('PRAGMA foreign_keys')[0].foreign_keys,1);assert.equal(clone.rows('PRAGMA integrity_check')[0].integrity_check,'ok')});
test('normal request → manual batch → supply/payment → receive → merchant collection',()=>{const t=setup();const r=t.request(2);const order=t.approve();assert.equal(order.lines[0].orderedQty,2);t.supply(2);let s=t.e.snapshot(t.e.scope());let detail=s.requests.find(x=>x.id===r.id)!;assert.equal(detail.reservation!.status,'confirmed');assert.equal(detail.reservation!.pickupDeadlineAt,null);t.send({type:'demo.receive',lineId:order.lines[0].id,receivedQty:2});detail=t.e.snapshot(t.e.scope()).requests[0];assert.equal(detail.reservation!.status,'pickup_ready');assert.equal(detail.reservation!.pickupDeadlineAt! - detail.reservation!.pickupAvailableAt!,172800000);t.send({type:'merchant.collect',reservationCode:detail.reservation!.code});assert.equal(t.e.snapshot(t.e.scope()).requests[0].reservation!.status,'collected');t.role(t.customer);assert.doesNotThrow(()=>t.request(1));t.e.assertInvariants()});
test('same command replays; different payload conflicts and customer cannot approve',()=>{const t=setup();const c=t.e.condition(t.store,t.sku);const cmd:DemoCommand={type:'request.create',sku:t.sku,storeId:t.store,quantity:1,acceptedPriceKrw:c.sale_price_krw,conditionVersion:c.version,consent:{accepted:true,termsVersion:'v1'}};t.send(cmd,'same');assert.equal(t.send(cmd,'same').effect,'replayed');code(()=>t.send({...cmd,quantity:2},'same'),'IDEMPOTENCY_CONFLICT');code(()=>t.send({type:'autoOrder.run',storeId:t.store}),'FORBIDDEN');assert.equal(t.e.all('purchase_requests').length,1)});
test('MOQ is not intake cap; 13 requests and multiple6 produce12 then1 pending',()=>{const t=setup();t.condition({minimumOrderQty:6,orderMultiple:6});for(let i=1;i<=13;i++)t.request(1,`DEMO-CUSTOMER-${String(i).padStart(3,'0')}`);const order=t.approve();assert.equal(order.lines[0].orderedQty,12);assert.equal(t.e.demand(t.store)[0].validPendingQty,13);assert.equal(t.e.demand(t.store)[0].newOrderNeedQty,1);t.send({type:'merchant.review',storeId:t.store});const p=t.e.snapshot(t.e.scope()).proposals.at(-1)!;assert.equal(p.lines.length,0);assert.equal(t.e.all('purchase_requests').length,13)});
test('strict whole FIFO accumulates sources, does not bypass leading3 for trailing1',()=>{const t=setup();t.request(3);t.request(1,'DEMO-CUSTOMER-002');const first=t.approve();t.supply(2);assert.equal(t.e.snapshot(t.e.scope()).requests.filter(r=>r.reservation).length,0);assert.equal(t.e.demand(t.store)[0].newOrderNeedQty,2);const second=t.approve();t.supply(2);const rs=t.e.snapshot(t.e.scope()).requests;assert.equal(rs.filter(r=>r.reservation?.status==='confirmed').length,2);assert.equal(rs[0].allocations.length,2);t.send({type:'demo.receive',lineId:first.lines[0].id,receivedQty:2});assert.equal(t.e.snapshot(t.e.scope()).requests[0].reservation!.status,'confirmed');t.send({type:'demo.receive',lineId:second.lines[0].id,receivedQty:2});assert.equal(t.e.snapshot(t.e.scope()).requests[0].reservation!.status,'pickup_ready')});
test('cancel keeps submitted coverage; shortage releases links but does not replenish capacity',()=>{const t=setup();t.condition({availableOrderQty:10});const r=t.request(8);const order=t.approve();t.role(t.customer);t.send({type:'request.cancel',requestId:r.id,expectedRequestVersion:r.version});t.request(8,'DEMO-CUSTOMER-002');t.role(t.merchant);assert.equal(t.e.demand(t.store)[0].newOrderNeedQty,0);t.supply(3);assert.equal(t.e.condition(t.store,t.sku).available_order_qty,2);assert.equal(t.e.demand(t.store)[0].newOrderNeedQty,5);assert.equal(t.e.all('request_order_links','AND active=1').length,0);code(()=>t.supply(3,order.lines[0].id),'SUPPLY_ALREADY_CONFIRMED')});
test('stale approval is atomic and capacity/budget unchanged',()=>{const t=setup();t.request(3);t.role(t.merchant);t.send({type:'merchant.review',storeId:t.store});const p=t.e.snapshot(t.e.scope()).proposals[0];const c=t.e.condition(t.store,t.sku);t.send({type:'demo.updateCondition',storeId:t.store,sku:t.sku,expectedConditionVersion:c.version,patch:{availableOrderQty:2}});code(()=>t.send({type:'proposal.approve',proposalId:p.id,expectedProposalVersion:p.version,confirmed:true}),'STALE_PROPOSAL');assert.equal(t.e.all('orders').length,0);assert.equal(t.e.budget(t.store).usedKrw,0);assert.equal(t.e.condition(t.store,t.sku).available_order_qty,2)});
test('price change blocks payment and explicit reconsent gets new FIFO position',()=>{const t=setup();const r=t.request(1);const order=t.approve();t.role(t.merchant);const c=t.e.condition(t.store,t.sku);t.send({type:'demo.updateCondition',storeId:t.store,sku:t.sku,expectedConditionVersion:c.version,patch:{salePriceKrw:c.sale_price_krw+100}});t.supply(1);assert.equal(t.e.all('mock_payments').length,0);t.role(t.customer);const current=t.e.snapshot(t.e.scope()).requests[0],condition=t.e.condition(t.store,t.sku);t.send({type:'request.reconsent',requestId:r.id,quantity:1,acceptedPriceKrw:condition.sale_price_krw,conditionVersion:condition.version,consent:{accepted:true,termsVersion:'v1'},expectedRequestVersion:current.version});assert.ok(t.e.snapshot(t.e.scope()).requests[0].sequence>r.sequence);assert.equal(t.e.pools()[0].unallocatedQty,1);assert.equal(order.lines[0].orderedQty,1)});
test('valid decrease keeps consent times/sequence; increase gets new sequence',()=>{const t=setup();const r=t.request(3);t.send({type:'request.changeQuantity',requestId:r.id,quantity:2,acceptedPriceKrw:r.acceptedPriceKrw,consent:{accepted:true,termsVersion:'v1'},expectedRequestVersion:r.version});let next=t.e.snapshot(t.e.scope()).requests[0];assert.equal(next.sequence,r.sequence);assert.equal(next.consent.expiresAt,r.consent.expiresAt);t.send({type:'request.changeQuantity',requestId:r.id,quantity:4,acceptedPriceKrw:r.acceptedPriceKrw,consent:{accepted:true,termsVersion:'v1'},expectedRequestVersion:next.version});next=t.e.snapshot(t.e.scope()).requests[0];assert.ok(next.sequence>r.sequence)});
test('consent expires exactly at7days; paid waiting reservation does not expire',()=>{const t=setup();t.request();t.role(t.merchant);t.send({type:'demo.advanceTime',deltaMs:7*86400000});assert.equal(t.e.snapshot(t.e.scope()).requests[0].status,'review_required');const u=setup();u.request();u.approve();u.supply(1);u.send({type:'demo.advanceTime',deltaMs:8*86400000});assert.equal(u.e.snapshot(u.e.scope()).requests[0].reservation!.status,'confirmed')});
test('payment known failure explicit retry success; secondfailure releases exactly once',()=>{const t=setup();t.role(t.merchant);t.send({type:'demo.setPaymentOutcome',actorId:t.customer,outcomes:['failure','success']});const r=t.request();t.approve();t.supply(1);assert.equal(t.e.snapshot(t.e.scope()).requests[0].reservation!.status,'payment_failed');assert.equal(t.e.all('notifications').length,0);t.role(t.customer);t.send({type:'payment.retry',requestId:r.id,paymentCycle:1});assert.equal(t.e.snapshot(t.e.scope()).requests[0].reservation!.status,'confirmed');const u=setup();u.role(u.merchant);u.send({type:'demo.setPaymentOutcome',actorId:u.customer,outcomes:['failure','failure']});const rr=u.request();u.approve();u.supply(1);u.role(u.customer);u.send({type:'payment.retry',requestId:rr.id,paymentCycle:1});assert.equal(u.e.snapshot(u.e.scope()).requests[0].status,'review_required');assert.equal(u.e.pools()[0].unallocatedQty,1);code(()=>u.send({type:'payment.retry',requestId:rr.id,paymentCycle:1}),'PAYMENT_RETRY_NOT_ALLOWED')});
test('10minute hold and exact48hour pickup enforce direct clock boundary',()=>{const t=setup();t.role(t.merchant);t.send({type:'demo.setPaymentOutcome',actorId:t.customer,outcomes:['failure']});const r=t.request();t.approve();t.supply(1);t.send({type:'demo.advanceTime',deltaMs:600000});assert.equal(t.e.pools()[0].unallocatedQty,1);t.role(t.customer);code(()=>t.send({type:'payment.retry',requestId:r.id,paymentCycle:1}),'PAYMENT_RETRY_NOT_ALLOWED');const u=setup();u.request();const o=u.approve();u.supply(1);u.send({type:'demo.receive',lineId:o.lines[0].id,receivedQty:1});const res=u.e.snapshot(u.e.scope()).requests[0].reservation!;u.send({type:'demo.advanceTime',deltaMs:172800000});code(()=>u.send({type:'merchant.collect',reservationCode:res.code}),'PICKUP_EXPIRED');assert.equal(u.e.snapshot(u.e.scope()).requests[0].reservation!.pickupDeadlineAt,res.pickupDeadlineAt)});
test('budget settlement stays on approval day and original cost',()=>{const t=setup();t.request(3);const o=t.approve();const cost=o.lines[0].purchaseCostKrw;const day=o.budgetDay;t.send({type:'demo.advanceTime',deltaMs:86400000});t.supply(2);assert.equal(t.e.budget(t.store,day).usedKrw,2*cost);assert.equal(t.e.budget(t.store).usedKrw,0)});
test('approved auto policy runs without per-order approval; disabled policy stops new orders',()=>{const t=setup();t.role(t.merchant);const p=t.e.policy(t.store);t.send({type:'policy.update',storeId:t.store,expectedPolicyVersion:p.version,enabled:true,skuScope:[t.sku],categoryScope:[],dailyBudgetKrw:50000,confirmed:true});t.request(2);assert.equal(t.e.all('orders').length,1);t.role(t.merchant);t.send({type:'autoOrder.run',storeId:t.store});assert.equal(t.e.all('orders').length,1);t.send({type:'policy.update',storeId:t.store,expectedPolicyVersion:2,enabled:false,skuScope:[t.sku],categoryScope:[],dailyBudgetKrw:50000,confirmed:true});t.request(1,'DEMO-CUSTOMER-002');assert.equal(t.e.all('orders').length,1)});
test('needs and agent error logs never count as purchase demand; public detail hides original text',()=>{const t=setup();t.send({type:'need.record',storeId:t.store,originalText:'없는 과자 찾아요',dialogue:[],extractedClues:['과자'],candidateSkus:[],identificationStatus:'unidentified',reason:'no_match',observedAt:NOW,sourceRefs:[]});t.send({type:'agent.record',requestId:'llm1',mode:'live',model:'gpt-5-mini',promptVersion:'v1',catalogHash:manifest.catalogHash,usage:{inputTokens:10,outputTokens:5,totalTokens:15},providerCalled:true,latencyMs:100,status:'lookup_error'});assert.equal(t.e.all('purchase_requests').length,0);assert.equal(t.e.all('agent_runs').length,1);t.request();assert.equal('originalText' in t.e.snapshot(t.e.scope()).requests[0],false)});
test('reset invalidates old generation and other session is untouched',()=>{const t=setup();t.request();const other=new DomainEngine(t.e.db,()=>NOW,'OTHER');assert.equal(other.all('purchase_requests').length,0);t.role(t.merchant);const old=t.e.scope();t.send({type:'demo.reset',confirmed:true});assert.equal(t.e.all('purchase_requests').length,0);assert.equal(other.session().generation,1);code(()=>t.e.snapshot(old),'STALE_GENERATION')});
test('real SQL transaction rolls back replacement when new consent fails',()=>{const t=setup();const r=t.request();const c=t.e.condition(t.store,t.sku);code(()=>t.send({type:'request.replace',originalRequestId:r.id,expectedRequestVersion:r.version,newRequest:{sku:t.sku,storeId:t.store,quantity:2,acceptedPriceKrw:c.sale_price_krw+1,conditionVersion:c.version,consent:{accepted:true,termsVersion:'v1'}}}),'CONSENT_MISMATCH');assert.equal(t.e.one('purchase_requests',r.id).status,'pending');assert.equal(t.e.all('purchase_requests').length,1)});
test('durable snapshot failure rolls back successful SQL command and replay can succeed',async()=>{let stored:SnapshotEnvelope|null=null,fail=false;const store:SnapshotStore={async read(){return stored},async write(value){if(fail)throw Error('quota');stored={...value,bytes:value.bytes.slice()}}};const runtime=new DemoRuntime(SQL,bytes,store,manifest,()=>NOW);const init=await runtime.perform({operation:'initialize'});assert.equal(init.ok,true);const s=runtime.engine.snapshot(runtime.engine.scope()),c=s.conditions[0];const command:DemoCommand={type:'request.create',sku:c.sku,storeId:c.storeId,quantity:1,acceptedPriceKrw:c.salePriceKrw,conditionVersion:c.version,consent:{accepted:true,termsVersion:'v1'}};const context={...runtime.engine.scope(),commandId:'persist-test',correlationId:'persist-test'};fail=true;const bad=await runtime.perform({operation:'command',command,context});assert.equal(bad.ok,false);assert.equal(runtime.engine.all('purchase_requests').length,0);fail=false;const good=await runtime.perform({operation:'command',command,context});assert.equal(good.ok,true);const reopened=new DemoRuntime(SQL,bytes,store,manifest,()=>NOW);assert.equal((await reopened.perform({operation:'initialize'})).ok,true);assert.equal(reopened.engine.all('purchase_requests').length,1)});
test('not-listed label does not block known-price supply-capable request',()=>{const t=setup();t.condition({assortmentStatus:'not_listed',stockQty:0,supplyStatus:'available'});t.request(1);const o=t.approve();t.supply(1);assert.equal(o.lines[0].orderedQty,1);assert.equal(t.e.snapshot(t.e.scope()).requests[0].reservation!.status,'confirmed')});
test('budget proposal revision and undo retain explicit restriction and one batch',()=>{const t=setup();t.request(5);t.role(t.merchant);t.send({type:'merchant.review',storeId:t.store});let p=t.e.snapshot(t.e.scope()).proposals[0];t.send({type:'proposal.revise',proposalId:p.id,expectedProposalVersion:p.version,change:{scope:'once',excludeSkus:[t.sku]}});p=t.e.snapshot(t.e.scope()).proposals[0];assert.equal(p.lines.length,0);t.send({type:'proposal.undo',proposalId:p.id,expectedProposalVersion:p.version});p=t.e.snapshot(t.e.scope()).proposals[0];assert.equal(p.lines[0].quantity,5);t.send({type:'proposal.approve',proposalId:p.id,expectedProposalVersion:p.version,confirmed:true});assert.equal(t.e.all('orders').length,1)});
test('other customer and other merchant cannot read request details',()=>{const t=setup();const r=t.request();t.role('DEMO-CUSTOMER-002');code(()=>t.e.query({type:'requests.detail',requestId:r.id},t.e.scope()),'NOT_FOUND');const other=t.e.rows('SELECT id FROM stores WHERE id!=?',[t.store])[0].id;t.role('DEMO-MERCHANT-'+other);code(()=>t.e.query({type:'merchant.requestDetail',requestId:r.id},t.e.scope()),'NOT_FOUND');t.role(t.merchant);const own=t.e.query({type:'merchant.productRequests',sku:t.sku},t.e.scope()) as any[];assert.equal(own[0].id,r.id);assert.equal(own.reduce((n,r)=>n+r.quantitySummary.validPending,0),t.e.demand(t.store)[0].validPendingQty)});
test('receipt replay never extends deadline and late already-received pool becomes pickup ready',()=>{const t=setup();const r=t.request(3);const o=t.approve();t.supply(2);t.send({type:'demo.receive',lineId:o.lines[0].id,receivedQty:2},'receipt-original');t.role(t.customer);t.send({type:'request.cancel',requestId:r.id,expectedRequestVersion:t.e.one('purchase_requests',r.id).version});t.request(2,'DEMO-CUSTOMER-002');t.role(t.merchant);const ready=t.e.snapshot(t.e.scope()).requests.find(r=>r.actorId==='DEMO-CUSTOMER-002')!.reservation!;assert.equal(ready.status,'pickup_ready');t.send({type:'demo.advanceTime',deltaMs:1000});assert.equal(t.send({type:'demo.receive',lineId:o.lines[0].id,receivedQty:2},'receipt-original').effect,'replayed');assert.equal(t.e.snapshot(t.e.scope()).requests.find(r=>r.actorId==='DEMO-CUSTOMER-002')!.reservation!.pickupDeadlineAt,ready.pickupDeadlineAt)});
test('STRICT SQLite rejects fractional quantity and FK rejects crossed actor session',()=>{const t=setup();assert.throws(()=>t.e.run('UPDATE conditions SET available_order_qty=1.5 WHERE session_id=?',[t.e.sessionId]));const r=t.request();assert.throws(()=>t.e.run('UPDATE purchase_requests SET actor_id=? WHERE id=?',['missing',r.id]));t.e.assertInvariants()});
test('incompatible snapshot needs explicit recovery, ready client recovery cannot bypass merchant role',async()=>{let saved:SnapshotEnvelope|null={bytes,versions:{...manifest,seed:'old'},sessionId:'DEMO-SESSION-001',generation:7,actorId:'DEMO-CUSTOMER-001',roleEpoch:0,revision:0};const store:SnapshotStore={async read(){return saved},async write(v){saved=v}};const rt=new DemoRuntime(SQL,bytes,store,manifest,()=>NOW);const bad=await rt.perform({operation:'initialize'});assert.equal(bad.ok,false);if(!bad.ok)assert.equal(bad.error.code,'SNAPSHOT_INCOMPATIBLE');assert.equal((await rt.resetIncompatible(true)).ok,true);assert.equal(rt.engine.generation,8);assert.equal((await rt.resetIncompatible(true)).ok,false)});
test('permanent supply end moves unpaid request to review but does not cancel demand record',()=>{const t=setup();const r=t.request();t.role(t.merchant);const c=t.e.condition(t.store,t.sku);t.send({type:'demo.updateCondition',storeId:t.store,sku:t.sku,expectedConditionVersion:c.version,patch:{supplyStatus:'discontinued',reason:'모의 공급 종료'}});const view=t.e.snapshot(t.e.scope()).requests[0];assert.equal(view.id,r.id);assert.equal(view.status,'review_required');assert.equal(view.pendingReason,'supply_discontinued');assert.equal(t.e.demand(t.store)[0].newOrderNeedQty,0)});
