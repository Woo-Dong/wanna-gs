test('proposal change rejects unknown fields/SKUs/categories and preserves original executable draft',()=>{const t=setup();t.request();t.role(t.merchant);t.send({type:'merchant.review',storeId:t.store});const before=t.e.snapshot(t.e.scope()).proposals[0];for(const change of [{scope:'once',excludeSkus:['NONEXISTENT']},{scope:'once',budgetLimitKrw:0},{scope:'once',excludeCategories:['NONEXISTENT']},{scope:'once',maxQuantities:{NONEXISTENT:0}},{scope:'once',budgetCapKrw:-1}]){code(()=>t.send({type:'proposal.revise',proposalId:before.id,expectedProposalVersion:before.version,change:change as any}),'INVALID_INPUT');const after=t.e.snapshot(t.e.scope()).proposals[0];assert.equal(after.version,before.version);assert.deepEqual(after.lines,before.lines)}t.send({type:'proposal.revise',proposalId:before.id,expectedProposalVersion:before.version,change:{scope:'once',budgetCapKrw:0}});assert.equal(t.e.snapshot(t.e.scope()).proposals[0].lines.length,0)});
test('ADR005 one event orders at most cap3; replay adds0, next event adds3, demand10 preserved',()=>{const t=setup();t.request(10);t.role(t.merchant);const p=t.e.policy(t.store);t.send({type:'policy.update',storeId:t.store,expectedPolicyVersion:p.version,enabled:true,skuScope:[t.sku],categoryScope:[],dailyBudgetKrw:50000,maxQuantityPerReview:3,confirmed:true});const ordered=()=>t.e.all('order_lines').reduce((n,l)=>n+l.ordered_qty,0);assert.equal(ordered(),3);assert.equal(t.e.demand(t.store)[0].validPendingQty,10);t.send({type:'autoOrder.run',storeId:t.store},'cap-review');assert.equal(ordered(),6);t.send({type:'autoOrder.run',storeId:t.store},'cap-review');assert.equal(ordered(),6);t.send({type:'merchant.review',storeId:t.store});assert.equal(ordered(),9);assert.equal(t.e.demand(t.store)[0].newOrderNeedQty,1)});
test('ADR005 cap3 belowMOQ6 defers; omitted keeps3, disabling preserves3, explicitnull removes',()=>{const t=setup();t.condition({minimumOrderQty:6,orderMultiple:6});t.request(10);t.role(t.merchant);let p=t.e.policy(t.store);const base={type:'policy.update' as const,storeId:t.store,enabled:true,skuScope:[t.sku],categoryScope:[],dailyBudgetKrw:50000,confirmed:true as const};t.send({...base,expectedPolicyVersion:p.version,maxQuantityPerReview:3});assert.equal(t.e.all('orders').length,0);assert.equal(t.e.condition(t.store,t.sku).available_order_qty,60);p=t.e.policy(t.store);t.send({...base,expectedPolicyVersion:p.version,enabled:false});assert.equal(t.e.snapshot(t.e.scope()).policies[0].maxQuantityPerReview,3);p=t.e.policy(t.store);t.send({...base,expectedPolicyVersion:p.version,enabled:false,maxQuantityPerReview:null});assert.equal(t.e.snapshot(t.e.scope()).policies[0].maxQuantityPerReview,null);p=t.e.policy(t.store);t.send({...base,expectedPolicyVersion:p.version});assert.equal(t.e.all('order_lines')[0].ordered_qty,6)});
test('ADR005 current proposal and active policy use smaller cap; manual approval does not trigger extra auto',()=>{const t=setup();t.request(10);t.role(t.merchant);t.send({type:'policy.update',storeId:t.store,expectedPolicyVersion:1,enabled:true,skuScope:[t.sku],categoryScope:[],dailyBudgetKrw:50000,maxQuantityPerReview:3,confirmed:true});t.send({type:'merchant.review',storeId:t.store});let p=t.e.snapshot(t.e.scope()).proposals.at(-1)!;assert.equal(p.lines[0].quantity,3);t.send({type:'proposal.revise',proposalId:p.id,expectedProposalVersion:p.version,change:{scope:'once',maxQuantities:{[t.sku]:2}}});p=t.e.snapshot(t.e.scope()).proposals.at(-1)!;assert.equal(p.lines[0].quantity,2);const before=t.e.all('order_lines').reduce((n,l)=>n+l.ordered_qty,0);t.send({type:'proposal.approve',proposalId:p.id,expectedProposalVersion:p.version,confirmed:true});assert.equal(t.e.all('order_lines').reduce((n,l)=>n+l.ordered_qty,0)-before,2)});
test('ADR005 invalid cap and unknown policy field roll back all fields',()=>{const t=setup();t.role(t.merchant);const before=t.e.policy(t.store);for(const changes of [{maxQuantityPerReview:0},{maxQuantityPerReview:-1},{maxQuantityPerReview:1.5},{maxQuantityPerReview:NaN},{maxQuantity:3}]){code(()=>t.send({type:'policy.update',storeId:t.store,expectedPolicyVersion:before.version,enabled:true,skuScope:[t.sku],categoryScope:[],dailyBudgetKrw:50000,confirmed:true,...changes} as any),'INVALID_INPUT');assert.deepEqual(t.e.policy(t.store),before)}});
test('unknown model usage is null with provider-attempt distinction and does not create demand',()=>{const t=setup();for(const [requestId,providerCalled] of [['timeout',true],['before-call',false]] as const)t.send({type:'agent.record',requestId,mode:'live',model:'gpt-5-mini',promptVersion:'v1',catalogHash:manifest.catalogHash,usage:null,providerCalled,latencyMs:100,status:'lookup_error'});const rows=t.e.all('agent_runs');assert.equal(rows.length,2);assert.equal(JSON.parse(rows[0].record_json).usage,null);assert.equal(JSON.parse(rows[0].record_json).providerCalled,true);assert.equal(JSON.parse(rows[1].record_json).providerCalled,false);assert.equal(t.e.all('purchase_requests').length,0);assert.equal(t.e.all('need_records').length,0)});
test('ADR005 capacity and budget below cap are preserved as tighter bounds',()=>{const t=setup();t.condition({availableOrderQty:2});t.request(10);t.role(t.merchant);const cost=t.e.condition(t.store,t.sku).purchase_cost_krw;t.send({type:'policy.update',storeId:t.store,expectedPolicyVersion:1,enabled:true,skuScope:[t.sku],categoryScope:[],dailyBudgetKrw:cost,maxQuantityPerReview:3,confirmed:true});assert.equal(t.e.all('order_lines')[0].ordered_qty,1);assert.equal(t.e.condition(t.store,t.sku).available_order_qty,1);assert.equal(t.e.budget(t.store).usedKrw,cost);assert.equal(t.e.demand(t.store)[0].validPendingQty,10)});
test('ADR005 snapshot save failure restores policy cap, budget, capacity and resulting auto order',async()=>{let saved:SnapshotEnvelope|null=null,fail=false;const store:SnapshotStore={async read(){return saved},async write(value){if(fail)throw Error('abort');saved={...value,bytes:value.bytes.slice()}}};const rt=new DemoRuntime(SQL,bytes,store,manifest,()=>NOW);await rt.perform({operation:'initialize'});const c=rt.engine.snapshot(rt.engine.scope()).conditions[0];const send=async(command:DemoCommand)=>{const id='durable-cap-'+(++counter);return rt.perform({operation:'command',command,context:{...rt.engine.scope(),commandId:id,correlationId:id}})};assert.equal((await send({type:'request.create',sku:c.sku,storeId:c.storeId,quantity:10,acceptedPriceKrw:c.salePriceKrw,conditionVersion:c.version,consent:{accepted:true,termsVersion:'v1'}})).ok,true);await rt.perform({operation:'switchRole',actorId:'DEMO-MERCHANT-'+c.storeId,scope:rt.engine.scope()});fail=true;const result=await send({type:'policy.update',storeId:c.storeId,expectedPolicyVersion:1,enabled:true,skuScope:[c.sku],categoryScope:[],dailyBudgetKrw:50000,maxQuantityPerReview:3,confirmed:true});assert.equal(result.ok,false);assert.equal(rt.engine.policy(c.storeId).enabled,0);assert.equal(rt.engine.policy(c.storeId).max_quantity_per_review,null);assert.equal(rt.engine.all('orders').length,0);assert.equal(rt.engine.condition(c.storeId,c.sku).available_order_qty,60);assert.equal(rt.engine.budget(c.storeId).usedKrw,0);assert.equal(rt.engine.all('purchase_requests')[0].quantity,10)});
test('live four-field model usage preserves optional cost without creating demand',()=>{const t=setup();for(const estimatedCostUsd of [0,0.00125,null]){const requestId='live-cost-'+String(estimatedCostUsd);const usage={inputTokens:10,outputTokens:5,totalTokens:15,estimatedCostUsd};t.send({type:'agent.record',requestId,mode:'live',model:'gpt-5-mini',promptVersion:'v1',catalogHash:manifest.catalogHash,usage,providerCalled:true,latencyMs:100,status:'ok'});const record=JSON.parse(t.e.all('agent_runs','AND request_id=?',[requestId])[0].record_json);assert.deepEqual(record.usage,usage)}assert.equal(t.e.all('purchase_requests').length,0);assert.equal(t.e.all('need_records').length,0);assert.equal(t.e.all('orders').length,0)});
test('invalid live usage costs and missing or extra fields reject atomically',()=>{const t=setup();const base={inputTokens:10,outputTokens:5,totalTokens:15};const invalid=[...[-1,NaN,Infinity,'0.01',true,undefined].map(estimatedCostUsd=>({...base,estimatedCostUsd})),{...base,secret:'forbidden'},{inputTokens:10,outputTokens:5,estimatedCostUsd:0.01},{...base,totalTokens:16,estimatedCostUsd:0.01}];for(const usage of invalid){const before=t.e.session().revision;assert.throws(()=>t.send({type:'agent.record',requestId:'invalid-cost',mode:'live',model:'gpt-5-mini',promptVersion:'v1',catalogHash:manifest.catalogHash,usage:usage as any,providerCalled:true,latencyMs:100,status:'ok'}),/INVALID_INPUT/);assert.equal(t.e.session().revision,before);assert.equal(t.e.all('agent_runs').length,0)}assert.equal(t.e.all('purchase_requests').length,0)});
