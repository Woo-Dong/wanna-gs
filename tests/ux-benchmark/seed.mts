import fs from 'node:fs';import crypto from 'node:crypto';import initSqlJs from 'sql.js';
import {DomainEngine} from '../../src/domain/engine';
export const CLOCK=Date.UTC(2026,8,21,3);
export function assertEngineBinding(root:string){return Object.fromEntries(['src/domain/engine.ts','src/contracts/domain.ts'].map(file=>{const local=crypto.createHash('sha256').update(fs.readFileSync(new URL('../../'+file,import.meta.url))).digest('hex'),application=crypto.createHash('sha256').update(fs.readFileSync(root+'/'+file)).digest('hex');if(local!==application)throw Error('SEED_ENGINE_SOURCE_MISMATCH: '+file);return [file,local]}))}
export async function prepare(root:string,kind:string){const engineBinding=assertEngineBinding(root);const SQL=await initSqlJs(),bytes=fs.readFileSync(root+'/public/demo/seed.sqlite');const e=new DomainEngine(new SQL.Database(bytes),()=>CLOCK);const products=e.rows('SELECT * FROM products ORDER BY sku'),stores=e.rows('SELECT * FROM stores ORDER BY id'),store=stores[0];
 const wanted=['쫀득버터떡빵','라라스윗 망고 쫀득바','혜자로운 단팥크림빵'];const selected=wanted.map(name=>products.find(p=>p.name.includes(name)));if(selected.some(p=>!p))throw Error('PUBLIC_PRODUCTS_MISSING');const ten=[...selected,...products.filter(p=>!selected.some(x=>x!.sku===p.sku))].slice(0,10);
 for(const p of ten){if(!e.all('conditions','AND store_id=? AND sku=?',[store.id,p!.sku]).length)e.insert('conditions',{...e.all('conditions','AND store_id=?',[store.id])[0],sku:p!.sku});e.run('UPDATE conditions SET sale_price_krw=2000,purchase_cost_krw=1000,minimum_order_qty=1,order_multiple=1,available_order_qty=60,assortment_status=\'listed\',stock_qty=0,observation_status=\'observed\',observed_at=?,supply_status=\'available\',orderable_until=NULL WHERE store_id=? AND sku=?',[CLOCK,store.id,p!.sku]);}
 const send=(c:any)=>{const id=crypto.randomUUID();return e.dispatch(c,{...e.scope(),commandId:id,correlationId:id})};
 const request=(sku:string)=>send({type:'request.create',sku,storeId:store.id,quantity:2,acceptedPriceKrw:2000,conditionVersion:1,consent:{accepted:true,termsVersion:'ux-benchmark-synthetic-v1'}});
 if(kind==='batch'||kind==='exception')for(const p of ten)request(p!.sku);
 if(kind==='exception'){e.run('UPDATE conditions SET available_order_qty=0 WHERE store_id=? AND sku=?',[store.id,ten[0]!.sku]);e.run('UPDATE conditions SET minimum_order_qty=3 WHERE store_id=? AND sku=?',[store.id,ten[1]!.sku]);}
 if(kind==='reconsent'){request(selected[0]!.sku);e.switchRole('DEMO-MERCHANT-'+store.id,e.scope());send({type:'demo.updateCondition',storeId:store.id,sku:selected[0]!.sku,expectedConditionVersion:1,patch:{salePriceKrw:2100}});e.switchRole('DEMO-CUSTOMER-001',e.scope());}
 if(kind==='auto')e.run('UPDATE policies SET enabled=1,sku_scope_json=?,approved_by=?,approved_at=?,version=2 WHERE store_id=?',[JSON.stringify([selected[0]!.sku]),'DEMO-MERCHANT-'+store.id,CLOCK,store.id]);
 if(kind==='batch'||kind==='exception')e.switchRole('DEMO-MERCHANT-'+store.id,e.scope());
 e.assertInvariants();const s=e.snapshot(e.scope());const envelope={bytes:Array.from(e.db.export()),versions:s.versions,sessionId:s.session.id,generation:s.session.generation,actorId:s.actor.id,roleEpoch:s.roleEpoch,revision:s.session.revision};e.db.close();return {envelope,store,selected,ten,engineBinding,seedHash:crypto.createHash('sha256').update(bytes).digest('hex'),kind};}
