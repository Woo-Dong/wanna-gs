import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';import {assertEngineBinding} from './seed.mts';
test('seed preparation binds actual locally executed engine and contract to application root',()=>{const root=fs.mkdtempSync(path.join(os.tmpdir(),'ux-engine-binding-'));try{for(const file of ['src/domain/engine.ts','src/contracts/domain.ts']){fs.mkdirSync(path.dirname(root+'/'+file),{recursive:true});fs.copyFileSync(new URL('../../'+file,import.meta.url),root+'/'+file)}assert.equal(Object.keys(assertEngineBinding(root)).length,2);fs.appendFileSync(root+'/src/domain/engine.ts','\n// different source\n');assert.throws(()=>assertEngineBinding(root),/SEED_ENGINE_SOURCE_MISMATCH/)}finally{fs.rmSync(root,{recursive:true,force:true})}});
