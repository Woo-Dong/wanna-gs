import test from 'node:test';import assert from 'node:assert/strict';import {LiveBudgetV3}from'./live.mts';
function mock(outcome:any={trialFailed:false,stopCode:null,observation:{status:'ok',provider_called:true,usage:{total_tokens:3},cost_usd:.001}}){const ops:string[]=[];const b:any={token:'fake',stopped:null,trialFailed:false,attempts:0,observations:[],call:(op:string)=>{ops.push(op);return op==='reserve'?{attemptId:'fake'}:outcome},forward:LiveBudgetV3.prototype.forward,stop:LiveBudgetV3.prototype.stop,trialBegin:LiveBudgetV3.prototype.trialBegin};const route:any={abort:async()=>ops.push('abort'),fetch:async(o:any)=>{ops.push('fetch');assert.equal(o.maxRetries,0);assert.equal(o.maxRedirects,0);return {status:()=>200,json:async()=>({ok:true})}},fulfill:async()=>ops.push('fulfill')};return {b,route,ops}}
test('known accounted failure stops only current trial, never retries it',async()=>{const {b,route,ops}=mock({trialFailed:true,stopCode:null,observation:{status:'failed',provider_called:true,usage:{total_tokens:3},cost_usd:.001}});await b.forward(route);await b.forward(route);assert.deepEqual(ops,['reserve','fetch','finish','fulfill','abort']);assert.equal(b.stopped,null);b.trialBegin(1);assert.equal(b.trialFailed,false)});
test('unknown stop and uncertain finish never issue another fetch',async()=>{for(const uncertain of [false,true]){const {b,route,ops}=mock({trialFailed:true,stopCode:'V3_UNKNOWN_FATAL_OR_CONTRACT_STOP',observation:{status:'unknown',provider_called:null,usage:null,cost_usd:null}});if(uncertain){const old=b.call;b.call=(op:string)=>{if(op==='finish')throw Error('unknown');return old(op)}}await b.forward(route);await b.forward(route);assert.equal(ops.filter(o=>o==='fetch').length,1);assert(b.stopped)}});
test('reserve rejection never performs outbound and marks study stop',async()=>{const {b,route,ops}=mock();b.call=(op:string)=>{ops.push(op);if(op==='reserve')throw Error('COST_SOFT_STOP')};await b.forward(route);assert(!ops.includes('fetch'));assert(ops.includes('stop'));assert.equal(b.stopped,'COST_SOFT_STOP')});
test('UI delivery delay stays outside budget instrumentation',async()=>{const {b,route}=mock();route.fulfill=async()=>new Promise(r=>setTimeout(r,30));const r=await b.forward(route);assert(r.deliveryMs>=20);assert(r.budgetInstrumentationMs<r.deliveryMs)});
