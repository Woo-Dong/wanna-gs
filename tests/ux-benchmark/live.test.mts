import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';import {LiveBudget} from './live.mts';
function setup(){const root=fs.mkdtempSync(path.join(os.tmpdir(),'ux-live-transport-'));const source=process.env.UX_BUDGET_TEST_ROOT??process.cwd();for(const file of ['scripts/run_nl_eval.py','evals/adapter.py','evals/scorer.py']){fs.mkdirSync(path.dirname(root+'/'+file),{recursive:true});fs.copyFileSync(source+'/'+file,root+'/'+file)}const ledger=root+'/artifacts/private/run-20260921/nl-budget.json';fs.mkdirSync(path.dirname(ledger),{recursive:true});fs.writeFileSync(ledger,JSON.stringify({version:'E02-v1',prior_call_reserve:50,prior_actual_calls:'unknown',prior_cost_reserve_usd:2.5,prior_actual_cost_usd:'unknown',unknown_attempt_cost_reserve_usd:.05,attempts:{},holdout_claims:{}}));const config=root+'/config.json';fs.writeFileSync(config,JSON.stringify({approved:true,run_id:'private-synthetic-test',stage:'baseline',prior_call_reserve:50,authorized_calls:18,mandatory_reserve:{future:10},mandatory_cost_reserve_usd:1,origin:'http://localhost:3217',model:'test',prompt_version:'p',catalog_hash:'c'}));const budget=new LiveBudget(root,config,'http://localhost:3217');budget.begin('private-output','workload');return {budget,root,ledger};}
test('actual response forwarded unchanged only after reserved attempt, with retries and redirects disabled',async()=>{const {budget,root,ledger}=setup();try{const response={status:()=>200,json:async()=>({ok:true,data:{mode:'live',model:'test',promptVersion:'p',catalogHash:'c',result:{unchanged:'sentinel'},usage:{inputTokens:1,outputTokens:1,totalTokens:2,estimatedCostUsd:.001}}})};let calls=0,forwarded:any;const route={fetch:async(options:any)=>{calls++;assert.equal(options.maxRetries,0);assert.equal(options.maxRedirects,0);const attempts=Object.values(JSON.parse(fs.readFileSync(ledger,'utf8')).attempts) as any[];assert.equal(attempts[0].status,'pending');return response},fulfill:async(value:any)=>{forwarded=value.response},abort:async()=>assert.fail('normal aborted')};const result=await budget.forward(route);assert.equal(calls,1);assert.equal(forwarded,response);assert.equal(result?.stopped,null);assert.ok(result!.networkEnd>=result!.networkStart);assert.equal(budget.observations[0].provider_called,true)}finally{fs.rmSync(root,{recursive:true,force:true})}});
test('unknown request stops all subsequent fetches and keeps null usage',async()=>{const {budget,root,ledger}=setup();try{let calls=0,aborts=0;const route={fetch:async()=>{calls++;throw Error('synthetic network loss')},abort:async()=>{aborts++},fulfill:async()=>assert.fail('unknown response fabricated')};await budget.forward(route);await budget.forward(route);assert.equal(calls,1);assert.equal(aborts,2);assert.equal(budget.observations[0].usage,null);assert.equal(budget.observations[0].provider_called,null);const items=Object.values(JSON.parse(fs.readFileSync(ledger,'utf8')).attempts) as any[];assert.equal(items.length,1);assert.equal(items[0].cost,null);assert.throws(()=>budget.begin('another-output','workload'),/ALREADY_CLAIMED/)}finally{fs.rmSync(root,{recursive:true,force:true})}});
test('UI response delivery latency is not subtracted as budget instrumentation',async()=>{const budget=Object.assign(Object.create(LiveBudget.prototype),{stopped:null,attempts:0,observations:[],call:(op:string)=>op==='reserve'?{attemptId:'synthetic'}:{continue:true,observation:{provider_called:true}}});const response={status:()=>200,json:async()=>({})};const result=await budget.forward({fetch:async()=>response,fulfill:async()=>{await new Promise(resolve=>setTimeout(resolve,80))},abort:async()=>assert.fail('normal aborted')});assert.ok(result.deliveryMs>=70);assert.ok(result.budgetInstrumentationMs<result.deliveryMs/2);});
