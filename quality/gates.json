{
  "phase": "assistant-foundation",
  "scope": "N01 technical foundation + catalog and eval tooling only. Formal NL, domain and browser product gates remain pending.",
  "source_patterns": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/**/*.css",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/*.py",
    "tests/gates/*.py",
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "vercel.json",
    "quality/gates.json",
    ".github/workflows/*.yml",
    "AGENTS.md",
    "card.md",
    "docs/GOAL.md",
    "docs/CORE_REQUIREMENTS.md",
    "docs/DECISION_INDEX.md",
    "docs/02-decisions-and-open-questions.md",
    "docs/20-agent-roles-and-context.md",
    "docs/29-browser-sqlite-demo.md",
    "docs/decisions/ADR-002-demo-domain-policies.md",
    "docs/decisions/ADR-003-evaluation-and-demo-boundaries.md",
    "docs/execution/run-20260921/plan.md",
    "docs/execution/run-20260921/research.md",
    "docs/execution/run-20260921/context-app-v3.json",
    "docs/decisions/ADR-004-supplier-capacity.md",
    "docs/execution/run-20260921/domain-contract.md",
    "src/contracts/domain.ts",
    "src/contracts/assistant.ts",
    "data/seed/config.json",
    "data/seed/products.json",
    "data/seed/stores.json",
    "evals/manifest.json",
    "docs/execution/run-20260921/context-app-v4.json",
    "data/research/*.json",
    "data/research/*.py",
    "evals/*.py",
    "evals/tests/*.py",
    "tests/server/*.test.ts",
    "evals/*.json",
    "evals/*.jsonl"
  ],
  "checks": [
    {
      "id": "contracts",
      "command": [
        "python3",
        "scripts/check_contracts.py"
      ]
    },
    {
      "id": "catalog-source",
      "command": [
        "python3",
        "data/research/validate-candidates.py"
      ]
    },
    {
      "id": "gate-and-env-tests",
      "command": [
        "python3",
        "scripts/test_runner.py"
      ],
      "tests": true
    },
    {
      "id": "server-tests",
      "command": [
        "python3",
        "scripts/run_node_tests.py",
        "server-tests",
        "tests/server/*.test.ts"
      ],
      "tests": true,
      "counts_file": "artifacts/raw/server-tests.json"
    },
    {
      "id": "typecheck",
      "command": [
        "npm",
        "run",
        "typecheck"
      ]
    },
    {
      "id": "build",
      "command": [
        "npm",
        "run",
        "build"
      ]
    }
  ],
  "tasks": [
    {
      "id": "N01",
      "implementers": [
        "root"
      ],
      "requirements": [
        "CORE-03",
        "CORE-05",
        "CORE-11",
        "CORE-15",
        "CORE-21",
        "CORE-23",
        "CORE-25"
      ]
    }
  ],
  "context_manifest": "docs/execution/run-20260921/context-app-v4.json"
}
